#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

awk -v n="$n" '

# Load every line, then process from the array so we can look ahead

# (needed to detect a `---` separator followed by a heading, and to keep

# fence state accurate across the whole plan).

{ L[NR] = $0 }

END {

  # F[i] = fence state (0/1) *before* line i -- a quadruple-backtick line

  # itself toggles it, so a heading on the pair of lines after an opening

  # fence is inside the fence.

  F[0] = 0

  for (i = 1; i <= NR; i++) {

    F[i] = F[i-1]

    if (L[i] ~ /^```/) F[i] = !F[i-1]

  }



  # does any later task heading exist? only the LAST task can run off the

  # end of the plan into a trailing section, so only it needs the `---`

  # separator as an extra terminator.

  has_later = 0
  passed_start = 0  # seen the requested task heading yet? only a different
                    # task heading AFTER it makes this task "intermediate".
  for (i = 1; i <= NR; i++)
    if (!F[i] && L[i] ~ /^#+[ \t]+Task[ \t]+[0-9]+/) {
      if (L[i] ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)")) passed_start = 1
      else if (passed_start) { has_later = 1; break }
    }




  intask = 0    # currently inside the requested task heading

  stopnext = 0  # saw the boundary `---`; stop at the next heading

  for (i = 1; i <= NR; i++) {

    line = L[i]

    if (F[i]) { if (intask) print line; continue }

    if (line ~ /^#+[ \t]+Task[ \t]+[0-9]+/) {

      if (line ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)")) {

        intask = 1

        print line

      } else if (intask) { intask = 0 }   # reached the next task

      continue

    }

    if (stopnext && line ~ /^#+[ \t]+/) { intask = 0; continue }

    if (intask && (line ~ /^[ \t]*---+[ \t]*$/)) {

      # candidates: a `---` whose next non-blank line is a heading. If this

      # is the plan LAST task, that heading starts a trailing section --

      # keep the `---` but stop at the heading. For intermediate tasks the

      # next `Task` heading already terminates, so emit and keep scanning.

      j = i + 1

      while (j <= NR && L[j] !~ /[^ \t]/) j++

      if (j <= NR && !F[j] && (L[j] ~ /^#+[ \t]+/)) {

        print line

        if (!has_later) stopnext = 1

        continue

      }

    }

    if (intask) print line

  }

}

' "$plan" > "$out"

if [ ! -s "$out" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
