#!/usr/bin/env bash
# Resolve and ensure the working-tree directory SDD uses for one plan's
# short-lived artifacts: implementer reports, review packages, and the
# progress ledger. Print the plan directory's absolute path.
#
# One directory per plan (.superpowers/sdd/<plan-slug>/), keyed by the
# molecule's implement step id (e.g. pi-packages-mol-ogh), so a follow-up
# plan in the same working tree can never read or overwrite another plan's
# artifacts.
#
# The workspace lives in the working tree (not under .git/) because scratch
# artifacts should be git-ignored and outside the git object store. A
# self-ignoring .gitignore at .superpowers/sdd/ keeps every plan's workspace
# out of `git status` and out of accidental commits.
#
# Single source of truth for the workspace location.
#
# Usage: sdd-workspace SLUG
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace SLUG" >&2
  exit 2
fi

slug=$1
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "invalid slug: $slug" >&2; exit 2; }

root=$(git rev-parse --show-toplevel)
base="$root/.superpowers/sdd"
dir="$base/$slug"
mkdir -p "$dir"
printf '*\n' > "$base/.gitignore"
cd "$dir" && pwd
